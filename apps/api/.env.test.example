# Krevia API test configuration. Copy to apps/api/.env.test.
# The test runner DROPS and recreates this database on every run.
# REQUIRED: the database name must end with _test and must differ from the development DATABASE_URL.
NODE_ENV=test
DATABASE_URL=postgresql://USER@localhost:5432/krevia_test
CORS_ORIGINS=http://localhost:3100
SESSION_TTL_HOURS=720
# Tests log errors only; set debug to see every request line.
LOG_LEVEL=error
