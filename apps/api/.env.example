# Krevia API configuration. Copy to apps/api/.env and adjust. Placeholders only: never commit real secrets.
# REQUIRED variables are marked; everything else has a safe default.

NODE_ENV=development
PORT=4100

# REQUIRED. PostgreSQL connection URL for the development database.
# Replace USER (and add :PASSWORD if your server needs one). Must start with postgresql://
DATABASE_URL=postgresql://USER@localhost:5432/krevia_dev

# Comma-separated browser origins allowed to call the API (CORS + CSRF origin check).
CORS_ORIGINS=http://localhost:3100
# Session lifetime in hours (default 720 = 30 days).
SESSION_TTL_HOURS=720
# true behind HTTPS so session cookies get the Secure flag (always on in production).
COOKIE_SECURE=false
# Trust X-Forwarded-For from one proxy hop (per-IP rate limiting behind a load balancer).
TRUST_PROXY=false
# Login/register attempts allowed per client IP per window.
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_SECONDS=60

# Logging: LOG_LEVEL = error | warn | info | debug (default info; error in tests).
# LOG_FORMAT = json (one JSON object per line, default) | pretty (readable single lines).
LOG_LEVEL=info
LOG_FORMAT=json

# Development seed only (optional). The seed refuses to run when NODE_ENV=production.
# Leave a password empty to skip creating that demo account.
SEED_ADMIN_PHONE=9000000001
SEED_ADMIN_PASSWORD=
SEED_GUARD_PHONE=9000000002
SEED_GUARD_PASSWORD=
