# Krevia website configuration. Copy to apps/web/.env.local. All variables are optional.

# Server-side origin of the Krevia API (no path). Browser requests to /api/v1/* are proxied here,
# so the session cookie stays first-party to the website. Default: http://localhost:4100
API_URL=http://localhost:4100

# Server-side logging: LOG_LEVEL = error | warn | info | debug (default info); LOG_FORMAT = json | pretty.
LOG_LEVEL=info
LOG_FORMAT=json
